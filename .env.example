# FinGuard AI - Environment Variables
# =====================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env

# Gemini API (Ana LLM - Zorunlu)
GEMINI_API_KEY=

# Notion API (Rapor çıktıları - opsiyonel)
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=

# Tavily API (AI-optimized web arama)
TAVILY_API_KEY=

# Uygulama Ayarları
APP_ENV=development
APP_PORT=8000
